<?xml version="1.0"?>
<Container version="2">
  <Name>family-assistant</Name>
  <Repository>ghcr.io/andrew-demers/family-assistant:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Household assistant: a private Telegram bot that uses Claude to manage the Yuvomi grocery list, to-do list and calendar, proposes events found in Gmail, and builds the HEB cart. The image is built by GitHub Actions on every push to main (see README). Docker Compose is the recommended install.</Overview>
  <Category>Productivity:</Category>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/family-assistant" Mode="rw" Description="State: SQLite, Gmail tokens (google/), HEB session (heb/). Keep private." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/family-assistant</Config>
  <Config Name="TELEGRAM_BOT_TOKEN" Target="TELEGRAM_BOT_TOKEN" Default="" Description="From @BotFather." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="ALLOWED_TELEGRAM_IDS" Target="ALLOWED_TELEGRAM_IDS" Default="" Description="Comma-separated numeric Telegram user IDs." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="TELEGRAM_USER_NAMES" Target="TELEGRAM_USER_NAMES" Default="" Description="Display names, same order as the IDs." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="ANTHROPIC_API_KEY" Target="ANTHROPIC_API_KEY" Default="" Description="Claude API key." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="CLAUDE_MODEL" Target="CLAUDE_MODEL" Default="claude-sonnet-5-5" Description="Claude model ID, e.g. claude-sonnet-5-5 or claude-haiku-5-5." Type="Variable" Display="always" Required="true" Mask="false">claude-sonnet-5-5</Config>
  <Config Name="CLAUDE_EFFORT" Target="CLAUDE_EFFORT" Default="medium" Description="low, medium or high." Type="Variable" Display="advanced" Required="false" Mask="false">medium</Config>
  <Config Name="YUVOMI_URL" Target="YUVOMI_URL" Default="" Description="LAN address of Yuvomi, e.g. http://192.168.1.10:3000" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="YUVOMI_API_TOKEN" Target="YUVOMI_API_TOKEN" Default="" Description="Token with shopping:write, tasks:write, calendar:write." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="YUVOMI_GROCERY_LIST" Target="YUVOMI_GROCERY_LIST" Default="Shopping" Description="Exact name of the grocery list in Yuvomi." Type="Variable" Display="always" Required="true" Mask="false">Groceries</Config>
  <Config Name="DRY_RUN" Target="DRY_RUN" Default="true" Description="true: read only, replies start with [DRY RUN]. false: writes for real." Type="Variable" Display="always" Required="true" Mask="false">true</Config>
  <Config Name="GMAIL_ACCOUNTS" Target="GMAIL_ACCOUNTS" Default="" Description="Gmail account labels, e.g. andrew,partner. Empty turns the email scan off." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="GMAIL_ACCOUNT_NAMES" Target="GMAIL_ACCOUNT_NAMES" Default="" Description="Display names, same order as GMAIL_ACCOUNTS." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="GMAIL_EVENT_MODE" Target="GMAIL_EVENT_MODE" Default="propose" Description="propose (ask first) or auto." Type="Variable" Display="advanced" Required="false" Mask="false">propose</Config>
  <Config Name="GMAIL_SCAN_TIMES" Target="GMAIL_SCAN_TIMES" Default="07:00,17:00" Description="Daily scan times (America/Chicago)." Type="Variable" Display="advanced" Required="false" Mask="false">07:00,17:00</Config>
  <Config Name="GMAIL_QUERY" Target="GMAIL_QUERY" Default="newer_than:2d -category:promotions -category:social" Description="Gmail search for emails to read." Type="Variable" Display="advanced" Required="false" Mask="false">newer_than:2d -category:promotions -category:social</Config>
  <Config Name="GOOGLE_OAUTH_CLIENT_ID" Target="GOOGLE_OAUTH_CLIENT_ID" Default="" Description="Only needed where gmail-auth runs; tokens carry it." Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="GOOGLE_OAUTH_CLIENT_SECRET" Target="GOOGLE_OAUTH_CLIENT_SECRET" Default="" Description="Only needed where gmail-auth runs." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="HEB_DEFAULT_STORE" Target="HEB_DEFAULT_STORE" Default="" Description="Numeric HEB curbside store ID. Empty turns HEB ordering off." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="TZ" Target="TZ" Default="America/Chicago" Description="Time zone." Type="Variable" Display="advanced" Required="true" Mask="false">America/Chicago</Config>
  <Config Name="RATE_LIMIT_PER_MINUTE" Target="RATE_LIMIT_PER_MINUTE" Default="10" Description="Messages per user per minute." Type="Variable" Display="advanced" Required="false" Mask="false">10</Config>
  <Config Name="MAX_TOOL_ITERATIONS" Target="MAX_TOOL_ITERATIONS" Default="6" Description="Agent loop cap per message." Type="Variable" Display="advanced" Required="false" Mask="false">6</Config>
  <Config Name="MAX_TOKENS_PER_MESSAGE" Target="MAX_TOKENS_PER_MESSAGE" Default="60000" Description="Token cap per message." Type="Variable" Display="advanced" Required="false" Mask="false">60000</Config>
</Container>

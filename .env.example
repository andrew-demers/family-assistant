# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Everyone else is ignored silently.
ALLOWED_TELEGRAM_IDS=111111111,222222222
# Optional display names, same order as ALLOWED_TELEGRAM_IDS. Falls back to Telegram first name.
TELEGRAM_USER_NAMES=Andrew,Partner

# --- Claude ---
ANTHROPIC_API_KEY=
# Any current model ID. claude-sonnet-5-5 is the default; claude-haiku-5-5 is cheaper.
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high
CLAUDE_EFFORT=medium
# Server-side refusal fallback (Claude API only; ignored for Haiku models).
CLAUDE_REFUSAL_FALLBACK=true
# Per-message limits for the agent loop.
MAX_TOOL_ITERATIONS=6
MAX_TOKENS_PER_MESSAGE=60000
# Messages per user per minute.
RATE_LIMIT_PER_MINUTE=10

# --- Yuvomi ---
YUVOMI_URL=http://192.168.1.10:3000
# Scoped API token: shopping:write, tasks:write, calendar:write
YUVOMI_API_TOKEN=
# Name of the Yuvomi shopping list used for groceries (exact match).
YUVOMI_GROCERY_LIST=Shopping

# --- Gmail event scan (Phase 2). Leave GMAIL_ACCOUNTS empty to turn it off. ---
# Only needed on the PC where you run `gmail-auth` (the token files carry what the container needs).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# One short label per Gmail account; tokens live in /config/google/<label>.json
GMAIL_ACCOUNTS=andrew,partner
# Display names, same order as GMAIL_ACCOUNTS.
GMAIL_ACCOUNT_NAMES=Andrew,Partner
# propose (ask in Telegram first) or auto (add directly, still with read-back proof)
GMAIL_EVENT_MODE=propose
GMAIL_SCAN_TIMES=07:00,17:00
GMAIL_QUERY=newer_than:2d -category:promotions -category:social
GMAIL_MAX_PER_SCAN=25

# --- HEB cart (Phase 3). Leave HEB_DEFAULT_STORE empty to turn it off. ---
# Numeric HEB store ID of a curbside store.
HEB_DEFAULT_STORE=
# Only for local runs; the Docker image sets this itself.
# HEB_MCP_COMMAND=.heb/Scripts/texas-grocery-mcp.exe

# --- General ---
TZ=America/Chicago
DRY_RUN=true
# State folder for local runs. docker-compose always uses /config inside the container.
CONFIG_DIR=./config
LOG_LEVEL=INFO
